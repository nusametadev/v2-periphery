# Copy this file to .env and fill in real values. Never commit .env.
# .env is in .gitignore.

# Deployer private key (no 0x prefix required issues either way; ethers accepts both).
# Used for nagaraTestnet / nagara network deploys only. Leave unset for local hardhat network tests.
PRIVATE_KEY=

# Address to set as Factory.feeToSetter on deploy. Defaults to the deployer address if unset.
FEE_TO_SETTER=

# Address set as Factory.admin on deploy (can whitelist non-WNGRX pairs via setPairAllowed). Defaults to the deployer address if unset.
ADMIN=

# Optional: MINAR token address. If set, scripts/deploy.js will additionally
# create a MINAR/WNGRX pair after deploying Factory/Router02.
MINAR_ADDRESS=

# Optional: set to "true" to have scripts/deploy.js add initial liquidity to the
# MINAR/WNGRX pair after creating it. Only takes effect if MINAR_ADDRESS is set.
ADD_LIQUIDITY=false

# Optional RPC/chainId overrides (defaults are hardcoded in hardhat.config.js).
# NAGARA_TESTNET_RPC_URL=http://212.85.25.146:9944
# NAGARA_TESTNET_CHAIN_ID=16869
# NAGARA_MAINNET_RPC_URL=http://203.145.34.119:9944
# NAGARA_MAINNET_CHAIN_ID=16868
